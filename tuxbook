# --- Venv-Autostart -------------------------------------------------------
# Wird dieses Skript ohne aktiviertes Venv gestartet, wechselt es selbst in
# das Projekt-Venv (.venv neben dieser Datei) und fuehrt sich dort erneut
# aus. Dadurch funktioniert   ./tuxbook ...   auch ohne vorheriges
#   source .venv/bin/activate


def _reexec_in_venv() -> None:
    here = Path(__file__).resolve().parent
    venv_base = here / ".venv"
    if not (venv_base / "pyvenv.cfg").exists():
        return  # kein Projekt-Venv -> System-Python (User ist selbst zuständig)
    venv_py = venv_base / "bin" / "python3"
    if not venv_py.exists():
        return
    if getattr(sys, "prefix", "") == str(venv_base) or \
            os.environ.get("VIRTUAL_ENV") == str(venv_base):
        return  # laufen bereits im Ziel-Venv
    os.execv(str(venv_py), [str(venv_py)] + sys.argv)


_reexec_in_venv()
